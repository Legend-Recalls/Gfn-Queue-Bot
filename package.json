    "start:prod": "node dist/src/index.js"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
