{
  "name": "opennow-queue-bot",
  "version": "0.1.0",
  "description": "Continuous GFN queue probe for OpenNOW — multi-account queue ranking",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
